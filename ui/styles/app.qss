QWidget {
    color: #17352e;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 14px;
}

QMainWindow, QWidget#appBackground, QWidget#page, QStackedWidget {
    background: transparent;
}

QFrame[card="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0.3,
        stop:0 rgba(210, 245, 232, 115),
        stop:0.5 rgba(222, 248, 240, 125),
        stop:1 rgba(208, 242, 250, 112));
    border: 1px solid rgba(145, 212, 190, 140);
    border-radius: 14px;
}

QLabel#pageTitle {
    color: #102A43;
    font-size: 24px;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: #102A3A;
    font-size: 17px;
    font-weight: 650;
}

QLabel#fieldLabel {
    color: #425466;
    font-size: 12px;
    font-weight: 600;
}

QLabel#mutedText, QLabel[muted="true"] {
    color: #73808C;
}

QLabel#versionText {
    color: #73808C;
    font-size: 11px;
}

QLabel#errorBanner {
    color: #8f3f3f;
    background: rgba(255, 240, 239, 235);
    border: 1px solid rgba(207, 122, 116, 110);
    border-radius: 8px;
    padding: 9px 12px;
}

QLabel#successText {
    color: #247359;
    font-weight: 600;
}

QLabel#jsonStatus {
    color: #67847c;
    font-size: 12px;
}

QLabel#jsonStatus[status="warning"] {
    color: #9a5b32;
    font-weight: 600;
}

QPushButton, QToolButton {
    min-height: 40px;
    padding: 0 15px;
    color: #24483e;
    background: rgba(255, 255, 255, 107);
    border: 1px solid rgba(104, 171, 164, 76);
    border-radius: 11px;
    font-weight: 600;
}

QPushButton:hover, QToolButton:hover {
    background: rgba(255, 255, 255, 138);
    border-color: rgba(90, 207, 168, 95);
}

QPushButton:focus, QToolButton:focus {
    border-color: #5ACFA8;
}

QPushButton:pressed, QToolButton:pressed {
    background: rgba(235, 248, 242, 160);
}

QPushButton:disabled {
    color: #9FB4AD;
    background: rgba(242, 247, 245, 130);
    border-color: rgba(150, 178, 169, 50);
}

QPushButton[role="primary"] {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #26C579,
        stop:0.55 #0BA878,
        stop:1 #14AFC0);
    border: none;
    border-radius: 11px;
}

QPushButton[role="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #2DD185,
        stop:0.55 #0CB684,
        stop:1 #18BBCC);
    border: none;
}

QPushButton[role="primary"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #21B56D,
        stop:0.55 #099A6B,
        stop:1 #10A1B0);
}

QPushButton[role="primary"]:disabled {
    color: #9FB4AD;
    background: rgba(189, 220, 210, 180);
    border: none;
}

QPushButton[role="quiet"] {
    background: transparent;
    border-color: transparent;
}

QPushButton[role="quiet"]:hover {
    background: rgba(218, 241, 233, 175);
}

QWidget#noticeBanner {
    color: #5e4a19;
    background: rgba(255, 248, 221, 242);
    border: 1px solid rgba(190, 150, 55, 110);
    border-radius: 6px;
}

QWidget#noticeBanner QPushButton {
    min-height: 30px;
    padding: 0 10px;
}

QPushButton[danger="true"] {
    color: #9b4747;
    background: transparent;
    border-color: transparent;
}

QPushButton[danger="true"]:hover {
    color: #8a3434;
    background: rgba(252, 232, 230, 220);
    border-color: rgba(194, 91, 84, 95);
}

QPushButton[iconOnly="true"] {
    min-width: 38px;
    max-width: 38px;
    padding: 0;
}

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    color: #173a31;
    background: rgba(255, 255, 255, 107);
    border: 1px solid rgba(104, 171, 164, 76);
    border-radius: 10px;
    selection-background-color: #b9e4d4;
    selection-color: #173a31;
}

QLineEdit, QSpinBox, QComboBox {
    min-height: 38px;
    padding: 0 11px;
}

QSpinBox {
    padding-right: 2px;
}

QPlainTextEdit, QTextEdit {
    padding: 10px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #5ACFA8;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#projectList::item {
    min-height: 42px;
    margin: 2px 0;
    padding: 0 12px;
    color: #3e5f56;
    border-radius: 10px;
}

QListWidget#projectList::item:hover {
    background: rgba(185, 228, 212, 100);
}

QListWidget#projectList::item:selected {
    color: #07966F;
    background: rgba(104, 225, 174, 51);
    font-weight: 650;
    border-left: 3px solid #0BA878;
}

QListWidget#mappingList {
    background: rgba(249, 253, 251, 220);
    border: 1px solid rgba(111, 157, 144, 85);
    border-radius: 9px;
    padding: 5px;
}

QListWidget#mappingList::item {
    min-height: 43px;
    padding: 0 10px;
    margin: 2px;
    border-radius: 7px;
}

QListWidget#mappingList::item:selected {
    color: #205f4d;
    background: rgba(207, 237, 226, 220);
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget {
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    width: 9px;
    margin: 3px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    background: rgba(91, 142, 127, 95);
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 9px;
    margin: 3px;
    background: transparent;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    background: rgba(91, 142, 127, 95);
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F8FFFC,
        stop:0.5 #E6FAF2,
        stop:1 #F4FFFB);
}

QPushButton[taskMode="true"] {
    min-width: 96px;
    border-radius: 6px;
    background: rgba(248, 252, 250, 225);
}

QPushButton[taskMode="true"]:checked {
    color: #ffffff;
    background: #3d9a78;
    border-color: #3d9a78;
}

QToolButton {
    min-width: 98px;
}

QFrame#feedbackDropArea {
    background: rgba(255, 255, 255, 107);
    border: 1.5px dashed rgba(70, 145, 123, 95);
    border-radius: 12px;
}

QFrame#feedbackDropArea:focus {
    background: rgba(235, 248, 242, 150);
    border: 1.5px dashed #5ACFA8;
}

QLabel#dropTitle, QLabel#pendingFileName {
    color: #214b40;
    font-weight: 600;
}

QLabel#taskProjectName {
    color: #2f7560;
    font-size: 15px;
    font-weight: 650;
    padding-left: 8px;
}

QLabel#toolBindingStatus {
    color: #247359;
    font-size: 12px;
}

QLabel#toolBindingStatus[status="error"] {
    color: #a04b45;
}

QLabel#feedbackStatus {
    color: #2e765f;
    font-size: 11px;
}

QLabel#feedbackStatus[status="error"] {
    color: #a04b45;
}

QFrame#pendingFeedbackRow {
    background: rgba(249, 253, 251, 220);
    border: 1px solid rgba(121, 170, 155, 70);
    border-radius: 7px;
}

QLabel#acceptanceSummary {
    padding: 10px 12px;
    border: 1px solid rgba(103, 155, 139, 90);
    border-radius: 7px;
    background: rgba(241, 249, 246, 230);
    color: #256a55;
    font-weight: 650;
}

QLabel#acceptanceSummary[status="failed"] {
    color: #99433f;
    border-color: rgba(194, 91, 84, 100);
    background: rgba(253, 239, 237, 230);
}

QListWidget#acceptanceResultList {
    background: rgba(249, 253, 251, 220);
    border: 1px solid rgba(111, 157, 144, 85);
    border-radius: 7px;
    padding: 5px;
}

QListWidget#acceptanceResultList::item {
    min-height: 38px;
    padding: 0 10px;
    border-radius: 6px;
}

QListWidget#acceptanceResultList::item:selected {
    background: rgba(207, 237, 226, 220);
}

QListWidget#workflowProjectList {
    background: rgba(249, 253, 251, 220);
    border: 1px solid rgba(111, 157, 144, 85);
    border-radius: 8px;
    padding: 7px;
}

QListWidget#workflowMaterialList {
    background: rgba(249, 253, 251, 220);
    border: 1px solid rgba(111, 157, 144, 85);
    border-radius: 8px;
    padding: 6px;
}

QListWidget#workflowMaterialList::item {
    min-height: 36px;
    padding: 0 10px;
    margin: 2px;
    border-radius: 6px;
}

QListWidget#workflowMaterialList::item:selected {
    color: #205f4d;
    background: rgba(207, 237, 226, 220);
}

QListWidget#workflowProjectList::item {
    min-height: 44px;
    padding: 0 10px;
    margin: 2px;
    border-radius: 6px;
}

QListWidget#workflowProjectList::item:hover {
    background: rgba(222, 243, 236, 155);
}

QMenu {
    color: #173a31;
    background: #f8fcfa;
    border: 1px solid rgba(111, 157, 144, 100);
    padding: 5px;
}

QMenu::item {
    min-width: 150px;
    padding: 8px 14px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: rgba(207, 237, 226, 220);
}
